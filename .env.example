# ==========================================
# CATATCERDAS AI - ENVIRONMENT VARIABLES
# ==========================================

# Aplikasi URL (gunakan http://localhost:3000 untuk lokal)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
# Dapatkan dari Project Settings > API di Dashboard Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Gemini API Key
# Dapatkan dari Google AI Studio: https://aistudio.google.com/
# Digunakan server-side untuk parsing suara, OCR struk, dan financial AI assistant
GEMINI_API_KEY=your-gemini-api-key-here

# Opsional: Batasi login hanya email @gmail.com (true / false)
NEXT_PUBLIC_RESTRICT_GMAIL_ONLY=false
